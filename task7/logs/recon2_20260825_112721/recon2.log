/opt/robot/install/robot_hal/share/robot_hal/config/zsm/controller_manager.yaml
/opt/robot/install/robot_hal/share/robot_hal/config/zsm/robot_hal.yaml

-------- /opt/robot/install/robot_hal/share/robot_hal/config/zsm/controller_manager.yaml --------
controller_manager:
  ros__parameters:
    update_rate: 1000  # Hz

    joint_shm_controller:
      type: joint_controller/JointShmController

    imu_shm_publisher:
      type: imu_publisher/ImuShmPublisher
    
    switch_controller:
      type: switch_controller/SwitchController

    battery_controller:
      type: battery_controller/BatteryController

    sbus_controller:
      type: sbus_controller/SbusController

    fill_light_controller:
      type: fill_light_controller/FillLightController

    led_controller:
      type: led_controller/LedController
      
joint_shm_controller:
  ros__parameters:
    state_pub_rate: 200.0  # Hz, 0.0 to disable
    sensor_pub_rate: 1.0
    enable_pub_cmd: true
    enable_shm_control: true
    enable_topic_control: false
    joint_cmd_timeout: 500 # ms

    estop_kd: 35.0
    hw_estop_interface: hw_estop/switch_state
    estop_exclude_joints:
      - fl4_foot
      - fr4_foot
      - bl4_foot
      - br4_foot

    joint_cmd_shm_name: joint_cmd
    joint_state_shm_name: joint_state
    joints:
      - fl1_hip_roll
      - fl2_hip_pitch
      - fl3_knee_pitch
      - fl4_foot

      - fr1_hip_roll
      - fr2_hip_pitch
      - fr3_knee_pitch
      - fr4_foot

      - bl1_hip_roll
      - bl2_hip_pitch
      - bl3_knee_pitch
      - bl4_foot

      - br1_hip_roll
      - br2_hip_pitch
      - br3_knee_pitch
      - br4_foot

imu_shm_publisher:
  ros__parameters:
    pub_rate: 200.
    imu_names:
      - imu_central
    
    imu_central:
      frame_id: imu_sensor_frame
      enable_shm: true
      enable_topic: true
      interface_name: imu_central/state

switch_controller:
  ros__parameters:
    pub_rate: 10.
    # cmd_switches:    # switch list, controller will find switch_name/switch_cmd interface from resouces manager
      # - power_leg
      # - power_rk
      # - power_24v_in
      # - power_bat_fan
      # - power_ext_24v
      # - power_battery
      # - power_orin
      # - power_can
      # - front_light
      # - back_light
    
    state_switches:
      - hw_estop

battery_controller:
  ros__parameters:
    pub_rate: 1.
    batterys: 
      - battery1
      - battery2

sbus_controller:
  ros__parameters:
    state_interface_name: sbus/state
    min_channel_val: 42
    mid_channel_val: 1002
    max_channel_val: 1962
    dead_zone: 0.0
    min_vel_x: 1.0
    min_vel_y: 0.5
    min_yaw_rate: 1.0
    mid_vel_x: 2.0
    mid_vel_y: 0.8
    mid_yaw_rate: 2.0
    max_vel_x: 3.0
    max_vel_y: 1.0
    max_yaw_rate: 3.0
    vel_x_reverse: false
    vel_y_reverse: true
    yaw_reverse: true
    enable_ecal_topic_publish: true
    enable_ros_topic_publish: true
    publish_interval_ms: 10
    timeout_ms: 500

fill_light_controller:
  ros__parameters:
    auto_mode: false
    ambient_lux_threshold: 100.0
    ambient_light_lux_interface: light_sensor/lux
    light_names:
      - front_light
      - back_light

led_controller:
  ros__parameters:
    log_level: info
    lookup_rate: 10.
    led_front_cmd_ifs_name: led_front/cmd
    led_back_cmd_ifs_name: led_back/cmd
    estop_ifs_name: hw_estop/switch_state
  
-------- /opt/robot/install/robot_hal/share/robot_hal/config/zsm/robot_hal.yaml --------
robot_hal:
  ros__parameters:
    spinners: 4
    use_sim_time: false
    cpu_affinity: 7
    thread_priority: 90
    logger_enable: false
    logger_pool_size: 8192
    logger_thread_count: 4
    
    default_controllers:
      - switch_controller
      - battery_controller
      - imu_shm_publisher
      # - sbus_controller
      - fill_light_controller
      - led_controller
      - joint_shm_controller

power_control_driver:
  ros__parameters:
    Offline_time: 3000  # ms
    # dev: /dev/ttyUSB0
    dev: /dev/ttyCH9344USB6
    baudrate: 460800
    led_error_blink_count: 3
    # self test parameter
    min_power_fw_ver: 0x00000000
    min_power_bl_ver: 0x00000000
    min_hotswap_fw_ver: 0x00000000
    min_hotswap_bl_ver: 0x00000000
    # diagnoitcs
    power_low: 20
    power_min: 10

    battery_log_enable: true
    battery_log_size: 50  # MB
    battery_log_file_num: 10
    battery_log_dir: /home/robot/debug_log

gpio_driver:
  ros__parameters:
    gpio_names:
      - demo_gpio_input
    
    demo_gpio_input:
      direction: input
      chip: gpiochip0
      number: 10
      invert: false

zsi_imu_driver:
  ros__parameters:
    dev: /dev/ttyS1
    baudrate: 921600
    imu_name: imu_central
    filter_dt: 0.001
    filter_type: 0 # 0: null, 1: digital_lp_filter
    recv_timeout: 500  #ms
    cpu_affinity: -1
    thread_priority: 90
    pose_param_path: /userdata/bak/calibration/pose_calibrate_param.yaml
    crc_error_threshold: 8  # 一定时间内允许的 CRC 错误总数
    crc_consecutive_error_threshold: 5  # 连续CRC错误次数超过该值则报警

ltr_light_sensor_driver:
  ros__parameters:
    light_sensor_name: light_sensor
    dev: /dev/i2c-2
    address: 0x23
    fetch_rate: 1.0
    window_factor: 1.0
    gain: 1
    integration_time: 100
    measurement_rate: 400

zsi_actuator_driver:
  ros__parameters:
    recv_cpu_affinity: -1
    recv_thread_priority: 90
    limit_enable: true
    limit_tolerance: 0.1
    temp_max: 215.
    temp_min: -40.
    temp_warn: 100.
    temp_protect: 110.
    temp_protect_recover: 90.
    Offline_time: 500 #ms

    debug_log_enable: true
    debug_log_size: 50  # MB
    debug_log_file_num: 10
    debug_log_dir: /home/robot/debug_log

    actuator_groups:
      - front_left_leg
      - front_right_leg
      - back_left_leg
      - back_right_leg
    
    front_left_leg:
      can_port: 0
      name_list:
        - fl1_hip_roll
        - fl2_hip_pitch
        - fl3_knee_pitch
        - fl4_foot
      id_list: [1, 2, 3, 4]
      sw_ver_min: [0, 0, 0, 0]
      hw_ver_min: [0, 0, 0, 0]
      pos_limit_min: [-1.22, 0., 0., 0.]
      pos_limit_max: [0., 4.886, 5.602, 0.]
  
    front_right_leg:
      can_port: 1
      name_list:
        - fr1_hip_roll
        - fr2_hip_pitch
        - fr3_knee_pitch
        - fr4_foot
      id_list: [1, 2, 3, 4]
      sw_ver_min: [0, 0, 0, 0]
      hw_ver_min: [0, 0, 0, 0]
      pos_limit_min: [0., -4.886, -5.602, 0.]
      pos_limit_max: [1.22, 0., 0., 0.]
    
    back_left_leg:
      can_port: 2
      name_list:
        - bl1_hip_roll
        - bl2_hip_pitch
        - bl3_knee_pitch
        - bl4_foot
      id_list: [1, 2, 3, 4]
      sw_ver_min: [0, 0, 0, 0]
      hw_ver_min: [0, 0, 0, 0]
      pos_limit_min: [0., -4.886, -5.602, 0.]
      pos_limit_max: [1.22, 0., 0., 0.]

    back_right_leg:
      can_port: 3
      name_list:
        - br1_hip_roll
        - br2_hip_pitch
        - br3_knee_pitch
        - br4_foot
      id_list: [1, 2, 3, 4]
      sw_ver_min: [0, 0, 0, 0]
      hw_ver_min: [0, 0, 0, 0]
      pos_limit_min: [-1.22, 0., 0., 0.]
      pos_limit_max: [0., 4.886, 5.602, 0.]
