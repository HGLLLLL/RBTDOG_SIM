ZGWS_dance_1:
  - name: stand
    type: consecutive
    control_mode: 1
    motion_mode: 10
    duration: 0.0
    vel_cmd: [0.0, 0.0, 0.0]
    angular_cmd: [0.0, 0.0, 0.0]

  - name: twist
    type: continuous
    control_mode: 21
    motion_mode: 100
    duration: 1.0
    vel_cmd: [0.0, 0.0, 0.0]
    angular_cmd: [0.0, 0.0, 0.5]

  - name: twist
    type: continuous
    control_mode: 21
    motion_mode: 100
    duration: 1.0
    vel_cmd: [0.0, 0.0, 0.0]
    angular_cmd: [0.0, 0.0, -0.5]

  - name: twist
    type: continuous
    control_mode: 21
    motion_mode: 100
    duration: 1.0
    vel_cmd: [0.0, 0.0, 0.0]
    angular_cmd: [0.0, 0.0, 0.5]

  - name: twist
    type: continuous
    control_mode: 21
    motion_mode: 100
    duration: 1.0
    vel_cmd: [0.0, 0.0, 0.0]
    angular_cmd: [0.0, 0.0, -0.5]

  - name: twist
    type: continuous
    control_mode: 21
    motion_mode: 100
    duration: 1.0
    vel_cmd: [0.0, 0.0, 0.0]
    angular_cmd: [0.0, 0.0, 0.0]

  - name: end
    type: consecutive
    control_mode: 18
    motion_mode: 1
    duration: 0.0
    vel_cmd: [0.0, 0.0, 0.0]
    angular_cmd: [0.0, 0.0, 0.0]
    
