-- /opt/release/version.yaml --
version: "0.1.7"
release_date: "2026-02-06"
description: "A2503 RK3588 Release Image with all modules"

modules:
  kernel:
    name: "Linux Kernel"
    tag: "v0.1.3"
    repo: "http://gitlab.jszr.com/jszr/embedded_software/zg/rk3588/rk3588_rt_sdk.git"

  rootfs:
    name: "Root Filesystem"
    tag: "v0.0.1"
    repo: "http://gitlab.jszr.com/jszr/embedded_software/zg/rk3588/rootfs.git"

  packages:
    - name: "robot-runtime"
      tag: "v0.1.2"
      repo: "http://gitlab.jszr.com/jszr/embedded_software/zg/rk3588/rootfs_overlay.git"
      
    - name: "zsibot_common"
      tag: "v0.5.8"
      repo: "http://gitlab.jszr.com/jszr/zsibot/zsibot_common.git"
      
    - name: "robot-launch"
      tag: "v0.1.5-r2"
      repo: "http://gitlab.jszr.com/jszr/jszr_launch.git"

    - name: "robot-ws"
      tag: "v0.1.4"
      repo: "http://gitlab.jszr.com/jszr/zsibot/robot_ws.git"

    - name: "motion-control"
      tag: "v0.4.6"
      repo: "http://gitlab.jszr.com/jszr/jszr_mc.git"

mcu_firmware:
  - name: "uart2canfd"
    tag: "v1.0.2"
    repo: "http://gitlab.jszr.com/jszr/embedded_software/zg/rk3588/mcu_firmware.git"

  - name: "power_board"
    tag: "v1.0.3"
    repo: "http://gitlab.jszr.com/jszr/embedded_software/zg/mcu/power_board.git"

  - name: "hot_swap_board"
    tag: "v0.1.4"
    repo: "http://gitlab.jszr.com/jszr/embedded_software/zg/mcu/hot_swap_board.git"

  # - name: "imu"
  #   tag: "v0.1.5"
  #   repo: "http://gitlab.jszr.com/jszr/embedded_software/xg01/mcu/imu_board.git"

ota_tools:
  name: "OTA Tools"
  tag: "v0.0.1"
  repo: "http://gitlab.jszr.com/jszr/embedded_software/zg/rk3588/ota_tools.git"

build_info:
  build_date: "2026-02-06 16:12:00"
  build_host: "rk3588-build-server"
  maintainer: "maintainer@zsibot.com"
@@KV firmware=version:"0.1.7"

