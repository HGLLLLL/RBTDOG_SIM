======== ROS2 環境（第一趟就是死在這一段） ========
-- /opt/runtime/env.bash --
export PATH=$PATH:/opt/runtime/bin
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/runtime/lib

source /opt/ros/humble/setup.bash
source /opt/robot/install/setup.bash
source /usr/share/colcon_cd/function/colcon_cd.sh
source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash
export ROS_DOMAIN_ID=66
export ROS_LOCALHOST_ONLY=0
export LC_NUMERIC="en_US.UTF-8"
export _colcon_cd_root=/opt/ros/humble/
export RMW_IMPLEMENTATION=rmw_zenoh_cpp #rmw_fastrtps_cpp
export RCUTILS_COLORIZED_OUTPUT=1
export RCUTILS_LOGGING_USE_STDOUT=1
export RCUTILS_LOGGING_BUFFERED_STREAM=1
export RCUTILS_CONSOLE_OUTPUT_FORMAT="[{date_time_with_ms}] [{severity}] [{name}]: {message}"
export ROBOT_LOG_DIR=/home/robot
export MILE_PATH=/userdata/robot
# export ROBOT_API_HOST=0.0.0.0
ROS_DOMAIN_ID=66  RMW=rmw_zenoh_cpp
ros2: /opt/ros/humble/bin/ros2
@@KV ros_domain_id=66

