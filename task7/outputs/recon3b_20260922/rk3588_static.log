@@KV host=robot
@@KV kernel=5.10.160-rt78-preempt
@@KV arch=aarch64
@@KV os=Ubuntu 22.04.5 LTS
@@KV board=Firefly AIO-3588SJD4 HDMI(Linux)
@@KV python3=Python 3.10.12
