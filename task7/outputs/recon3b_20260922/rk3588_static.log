  -- 全域設定（前 40 行）--
logLevel: info
logDestinations: [stdout]
logFile: mediamtx.log
readTimeout: 10s
writeTimeout: 10s
writeQueueSize: 512
udpMaxPayloadSize: 1472
runOnConnect:
runOnConnectRestart: no
runOnDisconnect:
authMethod: internal
authInternalUsers:
- user: any
  pass:
  ips: []
  permissions:
  - action: publish
    path:
  - action: read
    path:
  - action: playback
    path:
- user: any
  pass:
  ips: ['127.0.0.1', '::1']
  permissions:
  - action: api
  - action: metrics
  - action: pprof
authHTTPAddress:
authHTTPExclude:
- action: api
- action: metrics
- action: pprof
authJWTJWKS:
authJWTClaimKey: mediamtx_permissions
api: no
apiAddress: :9997
apiEncryption: no
apiServerKey: server.key
  -- ★ paths 段（RTSP 的路徑名稱與來源就在這，第一趟被 head 截掉了）--
paths:
  # example:
  # my_camera:
  #   source: rtsp://my_camera

  # Settings under path "all_others" are applied to all paths that
  # do not match another entry.
  all_others:
  -- rtsp 相關設定 --
135:apiEncryption: no
136:# Path to the server key. This is needed only when encryption is yes.
158:metricsEncryption: no
159:# Path to the server key. This is needed only when encryption is yes.
181:pprofEncryption: no
182:# Path to the server key. This is needed only when encryption is yes.
204:playbackEncryption: no
205:# Path to the server key. This is needed only when encryption is yes.
223:rtsp: yes
226:# server and clients, and doesn't support encryption.
228:# TCP is the most versatile, and does support encryption.
230:rtspTransports: [udp, multicast, tcp]
233:rtspEncryption: "no"
234:# Address of the TCP/RTSP listener. This is needed only when encryption is "no" or "optional".
235:rtspAddress: :8554
236:# Address of the TCP/TLS/RTSPS listener. This is needed only when encryption is "strict" or "optional".
237:rtspsAddress: :8322
248:# Path to the server key. This is needed only when encryption is "strict" or "optional".
252:rtspServerKey: server.key
253:# Path to the server certificate. This is needed only when encryption is "strict" or "optional".

