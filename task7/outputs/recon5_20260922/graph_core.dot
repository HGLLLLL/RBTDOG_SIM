  "nx:/bridge_image_topics_24" -> "nx:/perception_jobs" [label="front_camera/image_compressed"];
  "nx:/bridge_image_topics_24" -> "nx:/robot_slam" [label="front_camera/image_compressed"];
  "nx:/bt_navigator" -> "nx:/error_aggregator" [label="navigo/ea/cmn/intf/nav_error\nnavigo/ea/cmn/intf/nav_error_clear"];
  "nx:/charging_alignment_server" -> "nx:/arc_state_machine_node" [label="arc/nav_coarse_alignment_state\narc/nav_contact_alignment_state\n+1 個"];
  "nx:/charging_alignment_server" -> "nx:/remoix_rust_interface" [label="cmd_pos\ncmd_vel\n+1 個"];
  "nx:/collision_monitor" -> "nx:/error_aggregator" [label="navigo/ea/cmn/intf/nav_error\nnavigo/ea/cmn/intf/nav_error_clear"];
  "nx:/collision_monitor" -> "nx:/velocity_optimizer" [label="navigo/cs/cmn/intf/cmd_vel_valid"];
  "nx:/controller_server" -> "nx:/collision_monitor" [label="navigo/cs/cmn/intf/cmd_vel_raw"];
  "nx:/controller_server" -> "nx:/error_aggregator" [label="navigo/ea/cmn/intf/nav_error\nnavigo/ea/cmn/intf/nav_error_clear"];
  "nx:/kanon_rust_charge" -> "nx:/arc_state_machine_node" [label="arc/start_arc"];
  "nx:/kanon_rust_nav" -> "nx:/waypoint_follower" [label="start_navigation"];
  "nx:/localization" -> "nx:/arc_mapping_node" [label="odom/localization_odom"];
  "nx:/localization" -> "nx:/kanon_rust_loc" [label="localization_state"];
  "nx:/localization" -> "nx:/kanon_rust_nav" [label="localization_info"];
  "nx:/localization" -> "nx:/robot_tf" [label="odom/localization_odom"];
  "nx:/localization" -> "nx:/waypoint_follower" [label="localization_state"];
  "nx:/map_server" -> "nx:/global_costmap/global_costmap" [label="navigo/ms/cmn/intf/map"];
  "nx:/perception_jobs" -> "nx:/MEB" [label="laser_scan"];
  "nx:/perception_jobs" -> "nx:/collision_monitor" [label="laser_scan"];
  "nx:/perception_jobs" -> "nx:/controller_server" [label="laser_scan"];
  "nx:/perception_jobs" -> "nx:/error_aggregator" [label="laser_scan"];
  "nx:/perception_jobs" -> "nx:/local_costmap/local_costmap" [label="laser_scan"];
  "nx:/perception_jobs" -> "nx:/local_costmap_controller/local_costmap_controller" [label="laser_scan"];
  "nx:/planner_server" -> "nx:/error_aggregator" [label="navigo/ea/cmn/intf/nav_error\nnavigo/ea/cmn/intf/nav_error_clear"];
  "nx:/planner_server" -> "nx:/local_costmap/local_costmap" [label="navigo/ps/cmn/intf/clean_obstacles_around_goal"];
  "nx:/planner_server" -> "nx:/local_costmap_controller/local_costmap_controller" [label="navigo/ps/cmn/intf/clean_obstacles_around_goal"];
  "nx:/remoix_rust_interface" -> "nx:/MEB" [label="handle_vel"];
  "nx:/remoix_rust_interface" -> "nx:/arc_state_machine_node" [label="arc/dock_state\narc/mc_state"];
  "nx:/remoix_rust_interface" -> "nx:/kanon_rust_charge" [label="arc/dock_state"];
  "nx:/remoix_rust_interface" -> "nx:/localization" [label="odom/mc_odom"];
  "nx:/remoix_rust_interface" -> "nx:/robot_tf" [label="odom/mc_odom"];
  "nx:/robot_slam" -> "nx:/kanon_rust_slam" [label="pub_slam_state"];
  "nx:/robot_slam" -> "nx:/robot_tf" [label="odom/slam_odom"];
  "nx:/robot_tf" -> "nx:/arc_state_machine_node" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/behavior_server" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/bt_navigator" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/collision_monitor" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/controller_server" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/error_aggregator" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/global_costmap/global_costmap" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/local_costmap/local_costmap" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/local_costmap_controller/local_costmap_controller" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/planner_server" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/ros2_alg_interface" [label="odom/current_pose"];
  "nx:/robot_tf" -> "nx:/waypoint_follower" [label="odom/current_pose"];
  "nx:/ros2_alg_interface" -> "nx:/MEB" [label="meb_switch"];
  "nx:/rslidar_sdk/rslidar_points_destination_0" -> "nx:/arc_lvio_node" [label="front_lidar\nfront_lidar/imu"];
  "nx:/rslidar_sdk/rslidar_points_destination_0" -> "nx:/localization" [label="front_lidar\nfront_lidar/imu"];
  "nx:/rslidar_sdk/rslidar_points_destination_0" -> "nx:/perception_jobs" [label="front_lidar"];
  "nx:/rslidar_sdk/rslidar_points_destination_0" -> "nx:/robot_slam" [label="front_lidar\nfront_lidar/imu"];
  "nx:/rslidar_sdk/rslidar_points_destination_1" -> "nx:/arc_lvio_node" [label="rear_lidar"];
  "nx:/rslidar_sdk/rslidar_points_destination_1" -> "nx:/localization" [label="rear_lidar"];
  "nx:/rslidar_sdk/rslidar_points_destination_1" -> "nx:/robot_slam" [label="rear_lidar"];
  "nx:/sixents_gps_driver" -> "nx:/localization" [label="uni_best_nav\nuni_heading"];
  "nx:/velocity_optimizer" -> "nx:/remoix_rust_interface" [label="cmd_vel\nnavigation_cmd"];
  "nx:/waypoint_follower" -> "nx:/arc_state_machine_node" [label="navigation_state"];
  "nx:/waypoint_follower" -> "nx:/bt_navigator" [label="navigo/wf/cmn/intf/update_tracking_goal"];
  "nx:/waypoint_follower" -> "nx:/error_aggregator" [label="navigo/ea/cmn/intf/nav_error\nnavigo/ea/cmn/intf/nav_error_clear"];
  "nx:/waypoint_follower" -> "nx:/kanon_rust_nav" [label="navigation_state"];
  subgraph cluster_rk {
    label="RK3588（運控板）"; style=dashed; fontsize=15; color="#bbbbbb";
    subgraph cluster_rk_感測驅動 {
      label="感測驅動"; style="filled"; color="#f2f2f2"; fontsize=12;
      "rk:/robot_camera" [label="/robot_camera", shape=box, style="rounded,filled", fillcolor="#cde8d0"];
    }
    subgraph cluster_rk_運控HAL {
      label="運控／HAL"; style="filled"; color="#f2f2f2"; fontsize=12;
      "rk:/battery_controller" [label="/battery_controller", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/fill_light_controller" [label="/fill_light_controller", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/imu_shm_publisher" [label="/imu_shm_publisher", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/joint_shm_controller" [label="/joint_shm_controller", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/led_controller" [label="/led_controller", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/robot_diagnostic_manager" [label="/robot_diagnostic_manager", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/robot_hal" [label="/robot_hal", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/robot_manager" [label="/robot_manager", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/robot_monitor" [label="/robot_monitor", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/robot_remote" [label="/robot_remote", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
      "rk:/switch_controller" [label="/switch_controller", shape=box, style="rounded,filled", fillcolor="#f4cccc"];
    }
    subgraph cluster_rk_導航 {
      label="導航"; style="filled"; color="#f2f2f2"; fontsize=12;
      "rk:/robot_roamerx" [label="/robot_roamerx", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
    }
    subgraph cluster_rk_其他 {
      label="其他"; style="filled"; color="#f2f2f2"; fontsize=12;
      "rk:/bridge_image_topics_66" [label="/bridge_image_topics_66", shape=box, style="rounded,filled", fillcolor="#eeeeee"];
      "rk:/zsi_actuator_driver" [label="/zsi_actuator_driver", shape=box, style="rounded,filled", fillcolor="#eeeeee"];
    }
    subgraph cluster_rk_nonros {
      label="非 ROS 行程（走 eCAL／共享記憶體）"; style=filled; color="#fdf0f0"; fontsize=12;
      "rk:mc_ctrl" [label="mc_ctrl\n閉源運控核心\nROBOT_TYPE=ZGWS", shape=box, style="rounded,filled,bold", fillcolor="#ffe9e9", color="#b03030", fontsize=12];
      "rk:motors" [label="16 顆馬達\nCAN ×4", shape=box, style="rounded,filled,bold", fillcolor="#ffe9e9", color="#b03030", fontsize=12];
    }
  }
  "rk:/battery_controller" -> "rk:/led_controller" [label="battery_controller/battery1\nbattery_controller/battery2\n+1 個"];
  "rk:/battery_controller" -> "rk:/robot_remote" [label="battery_controller/battery1\nbattery_controller/battery2"];
  "rk:/battery_controller" -> "rk:/robot_roamerx" [label="battery_controller/battery1\nbattery_controller/battery2"];
  "rk:/fill_light_controller" -> "rk:/robot_remote" [label="fill_light_controller/auto_work_state\nfill_light_controller/back_light/state\n+2 個"];
  "rk:/imu_shm_publisher" -> "rk:/robot_remote" [label="imu_shm_publisher/imu_central"];
  "rk:/imu_shm_publisher" -> "rk:/robot_roamerx" [label="imu_shm_publisher/imu_central"];
  "rk:/joint_shm_controller" -> "rk:/robot_remote" [label="joint_shm_controller/joint_sensor"];
  "rk:/robot_camera" -> "rk:/bridge_image_topics_66" [label="front_camera/image_compressed\nrear_camera/image_compressed"];
  "rk:/robot_camera" -> "rk:/robot_remote" [label="robot_camera/record_mp4_ack\nrobot_camera/record_mp4_status\n+2 個"];
  "rk:/robot_diagnostic_manager" -> "rk:/led_controller" [label="robot_monitor/diagnostic_status"];
  "rk:/robot_diagnostic_manager" -> "rk:/robot_manager" [label="robot_monitor/diagnostic_status"];
  "rk:/robot_diagnostic_manager" -> "rk:/robot_remote" [label="robot_monitor/diagnostic_status"];
  "rk:/robot_manager" -> "rk:/joint_shm_controller" [label="robot_manager/robot_status"];
  "rk:/robot_manager" -> "rk:/led_controller" [label="robot_manager/robot_status"];
  "rk:/robot_manager" -> "rk:/robot_remote" [label="robot_manager/robot_status"];
  "rk:/robot_monitor" -> "rk:/led_controller" [label="robot_monitor/power_on_status"];
  "rk:/robot_monitor" -> "rk:/robot_remote" [label="robot_monitor/power_on_status"];
  "rk:/robot_remote" -> "rk:/fill_light_controller" [label="fill_light_controller/auto_work\nfill_light_controller/back_light/cmd\n+1 個"];
  "rk:/robot_remote" -> "rk:/led_controller" [label="estop_controller/sw_estop/state\nrobot_remote/locked_state\n+1 個"];
  "rk:/robot_remote" -> "rk:/robot_camera" [label="robot_camera/record_mp4\nrobot_camera/take_photo\n+1 個"];
  "rk:/robot_roamerx" -> "rk:/led_controller" [label="robot_roamerx/alg_dtc\nrobot_roamerx/alg_status"];
  "rk:/robot_roamerx" -> "rk:/robot_manager" [label="robot_roamerx/is_in_nav_control"];
  "rk:/robot_roamerx" -> "rk:/robot_remote" [label="arc/charging_dock_info"];
  "rk:/switch_controller" -> "rk:/robot_remote" [label="switch_controller/hw_estop/state"];
  // ---- 疊圖：eCAL 匯流排與具名共享記憶體（2026-09-22 實測）----
  "rk:/robot_remote" -> "rk:mc_ctrl" [label="eCAL ebf608ea\n遙控器指令", style=dashed, color="#2b6cb0", fontcolor="#2b6cb0", penwidth=1.6];
  "rk:/robot_roamerx" -> "rk:mc_ctrl" [label="eCAL d87af588\n導航指令（NX 來的）", style=dashed, color="#2b6cb0", fontcolor="#2b6cb0", penwidth=1.6];
  "rk:/robot_hal" -> "rk:mc_ctrl" [label="eCAL a74ae66c\n硬體層回饋（內容未驗）", style=dashed, color="#2b6cb0", fontcolor="#2b6cb0", penwidth=1.6];
  "rk:mc_ctrl" -> "rk:/robot_remote" [label="eCAL 8a14b62c\n狀態廣播", style=dashed, color="#2b6cb0", fontcolor="#2b6cb0", penwidth=1.6];
  "rk:mc_ctrl" -> "rk:/robot_roamerx" [label="eCAL 8a14b62c\n狀態廣播", style=dashed, color="#2b6cb0", fontcolor="#2b6cb0", penwidth=1.6];
  "rk:ecal_orphans" [label="eCAL 200f526f／301fbb4b／449d205f／cd623317\nmc_ctrl 發出、目前沒有任何訂閱者", shape=note, style=filled, fillcolor="#eef4fb", color="#2b6cb0", fontsize=9];
  "rk:mc_ctrl" -> "rk:ecal_orphans" [style=dashed, color="#2b6cb0"];
  "rk:mc_ctrl" -> "rk:/joint_shm_controller" [label="/dev/shm/joint_cmd\n16×{pos,vel,eff,kp,kd} f64；讀 1 kHz\n★ 我們的插入點", style=bold, color="#b03030", fontcolor="#b03030", penwidth=2.4];
  "rk:/joint_shm_controller" -> "rk:/zsi_actuator_driver" [label="ros2_control\n80 個 command interface", style=bold, color="#8a4b4b", fontcolor="#8a4b4b", penwidth=1.8];
  "rk:/zsi_actuator_driver" -> "rk:motors" [label="CAN ×4", style=bold, color="#8a4b4b", fontcolor="#8a4b4b", penwidth=1.8];
  "rk:/zsi_actuator_driver" -> "rk:/joint_shm_controller" [label="/dev/shm/joint_state\n16×{pos,vel,eff,temp,volt,err}", style=bold, color="#8a4b4b", fontcolor="#8a4b4b", penwidth=1.8];
  "rk:/joint_shm_controller" -> "rk:mc_ctrl" [label="/dev/shm/joint_state\n讀取者未驗", style=dotted, color="#aaaaaa", fontcolor="#aaaaaa", penwidth=1.8];
  "rk:/robot_hal" -> "rk:/imu_shm_publisher" [label="/dev/shm/imu_central\nimu_recv_thread 寫入", style=bold, color="#8a4b4b", fontcolor="#8a4b4b", penwidth=1.8];
  subgraph cluster_legend_rk {
    label="圖例"; style=filled; color="#fafafa"; fontsize=11;
    lg1 [label="→ ROS 2 topic（rmw_zenoh, DOMAIN 66）", shape=plaintext, fontsize=10];
    lg2 [label="⇢ eCAL（廠商內部匯流排, protobuf）", shape=plaintext, fontsize=10, fontcolor="#2b6cb0"];
    lg3 [label="⇒ /dev/shm 具名段（★ 我們的插入點）", shape=plaintext, fontsize=10, fontcolor="#b03030"];
    lg4 [label="點線＝方向或內容未驗", shape=plaintext, fontsize=10, fontcolor="#888888"];
    lg1 -> lg2 [style=invis]; lg2 -> lg3 [style=invis]; lg3 -> lg4 [style=invis];
  }
}
