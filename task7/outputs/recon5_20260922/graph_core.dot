  "nx:/behavior_server" -> "nx:/controller_server" [label="navigo/cs/cmn/intf/cmd_vel_raw"];
  "nx:/bridge_image_topics_24" -> "nx:/arc_lvio_node" [label="front_camera/image_compressed"];
  "nx:/bridge_image_topics_24" -> "nx:/arc_mapping_node" [label="front_camera/image_compressed"];
