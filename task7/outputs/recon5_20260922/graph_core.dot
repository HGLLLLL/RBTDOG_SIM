digraph ros_core {
  rankdir=LR; splines=spline; concentrate=true; newrank=true;
  graph [fontname="Sans", fontsize=11, nodesep=0.3, ranksep=1.4];
  node [fontname="Sans", fontsize=11];
  edge [fontname="Sans", fontsize=8, color="#8a8a8a", fontcolor="#444444"];
  subgraph cluster_nx {
    label="Orin NX（應用板）"; style=dashed; fontsize=15; color="#bbbbbb";
    subgraph cluster_nx_感測驅動 {
      label="感測驅動"; style="filled"; color="#f2f2f2"; fontsize=12;
      "nx:/rslidar_sdk/rslidar_points_destination_0" [label="/rslidar_sdk/rslidar_points_destination_0", shape=box, style="rounded,filled", fillcolor="#cde8d0"];
      "nx:/rslidar_sdk/rslidar_points_destination_1" [label="/rslidar_sdk/rslidar_points_destination_1", shape=box, style="rounded,filled", fillcolor="#cde8d0"];
      "nx:/sixents_gps_driver" [label="/sixents_gps_driver", shape=box, style="rounded,filled", fillcolor="#cde8d0"];
    }
    subgraph cluster_nx_SLAM定位 {
      label="SLAM／定位"; style="filled"; color="#f2f2f2"; fontsize=12;
      "nx:/MEB" [label="/MEB", shape=box, style="rounded,filled", fillcolor="#cfe2f3"];
      "nx:/arc_lvio_node" [label="/arc_lvio_node", shape=box, style="rounded,filled", fillcolor="#cfe2f3"];
      "nx:/arc_mapping_node" [label="/arc_mapping_node", shape=box, style="rounded,filled", fillcolor="#cfe2f3"];
      "nx:/aritag_location_pipline" [label="/aritag_location_pipline", shape=box, style="rounded,filled", fillcolor="#cfe2f3"];
      "nx:/kanon_rust_slam" [label="/kanon_rust_slam", shape=box, style="rounded,filled", fillcolor="#cfe2f3"];
      "nx:/localization" [label="/localization", shape=box, style="rounded,filled", fillcolor="#cfe2f3"];
      "nx:/robot_slam" [label="/robot_slam", shape=box, style="rounded,filled", fillcolor="#cfe2f3"];
      "nx:/robot_tf" [label="/robot_tf", shape=box, style="rounded,filled", fillcolor="#cfe2f3"];
    }
    subgraph cluster_nx_感知 {
      label="感知"; style="filled"; color="#f2f2f2"; fontsize=12;
      "nx:/perception_jobs" [label="/perception_jobs", shape=box, style="rounded,filled", fillcolor="#fce5cd"];
    }
    subgraph cluster_nx_導航 {
      label="導航"; style="filled"; color="#f2f2f2"; fontsize=12;
      "nx:/behavior_server" [label="/behavior_server", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/bt_navigator" [label="/bt_navigator", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/charging_alignment_server" [label="/charging_alignment_server", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/collision_monitor" [label="/collision_monitor", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/controller_server" [label="/controller_server", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/global_costmap/global_costmap" [label="/global_costmap/global_costmap", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/kanon_rust_charge" [label="/kanon_rust_charge", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/kanon_rust_loc" [label="/kanon_rust_loc", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/kanon_rust_nav" [label="/kanon_rust_nav", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/local_costmap/local_costmap" [label="/local_costmap/local_costmap", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/local_costmap_controller/local_costmap_controller" [label="/local_costmap_controller/local_costmap_controller", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/map_server" [label="/map_server", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/planner_server" [label="/planner_server", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/remoix_rust_interface" [label="/remoix_rust_interface", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/ros2_alg_interface" [label="/ros2_alg_interface", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/velocity_optimizer" [label="/velocity_optimizer", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
      "nx:/waypoint_follower" [label="/waypoint_follower", shape=box, style="rounded,filled", fillcolor="#d9d2e9"];
    }
    subgraph cluster_nx_其他 {
      label="其他"; style="filled"; color="#f2f2f2"; fontsize=12;
      "nx:/arc_state_machine_node" [label="/arc_state_machine_node", shape=box, style="rounded,filled", fillcolor="#eeeeee"];
      "nx:/bridge_image_topics_24" [label="/bridge_image_topics_24", shape=box, style="rounded,filled", fillcolor="#eeeeee"];
      "nx:/error_aggregator" [label="/error_aggregator", shape=box, style="rounded,filled", fillcolor="#eeeeee"];
      "nx:/rust_debug_node" [label="/rust_debug_node", shape=box, style="rounded,filled", fillcolor="#eeeeee"];
    }
  }
  "nx:/MEB" -> "nx:/remoix_rust_interface" [label="cmd_vel\nmeb_brake"];
  "nx:/MEB" -> "nx:/ros2_alg_interface" [label="meb_status"];
  "nx:/arc_lvio_node" -> "nx:/arc_state_machine_node" [label="arc/slam_dock_pose\narc/slam_state"];
  "nx:/arc_mapping_node" -> "nx:/kanon_rust_charge" [label="arc_mapping_state"];
  "nx:/arc_state_machine_node" -> "nx:/arc_lvio_node" [label="arc/slam_mode_cmd"];
  "nx:/arc_state_machine_node" -> "nx:/aritag_location_pipline" [label="arc/arc_state\narc/perception_mode_cmd"];
  "nx:/arc_state_machine_node" -> "nx:/charging_alignment_server" [label="arc/dock_pose\narc/nav_coarse_alignment_mode_cmd\n+2 個"];
  "nx:/arc_state_machine_node" -> "nx:/kanon_rust_charge" [label="arc/arc_state"];
  "nx:/arc_state_machine_node" -> "nx:/remoix_rust_interface" [label="arc/arc_state\narc/mc_mode_cmd\n+1 個"];
  "nx:/arc_state_machine_node" -> "nx:/rust_debug_node" [label="arc/arc_module_states_debug_info"];
  "nx:/arc_state_machine_node" -> "nx:/waypoint_follower" [label="start_navigation"];
  "nx:/aritag_location_pipline" -> "nx:/arc_state_machine_node" [label="arc/calibration_state\narc/perception_dock_pose\n+1 個"];
