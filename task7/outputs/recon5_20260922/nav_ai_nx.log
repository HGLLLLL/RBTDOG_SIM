        debug_mode: False
      inflation_layer:
        plugin: "navigo_costmap_2d::InflationLayer"
        cost_scaling_factor: 3.0
        inflation_radius: 0.1
      frontier_layer:
        plugin: "navigo_costmap_2d::FrontierLayer"
        map_subscribe_transient_local: False
        obstacle_inflation_radius: 0.3
        obstacle_threshold: 65
        travel_point_type: "closest" #closest middle centroid
        frontier_min_size: 10
