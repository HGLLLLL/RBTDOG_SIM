  gnss_timeout_sec: 60.0         # 超时时间(秒)
  skip_enabled: true             # 是否启用跳帧
  skip_interval: 3              # 跳帧间隔（1表示每帧都处理）
  yaw_traversal_enabled: true    # 启用yaw遍历
  yaw_step_deg: 15.0             # 遍历步长(度)
  yaw_min_deg: -180.0            # 最小yaw(度)
  yaw_max_deg: 180.0             # 最大yaw(度)
  max_yaw_rounds: 5              # 最大遍历轮次
  anchor_lat_deg: 39.894310063   # 地图原点(度)
  anchor_lon_deg: 116.290182563
  anchor_h_m: 42.6222

# 位姿平滑参数
fastlio2_pose_smoothing_options:
  enable_pose_smoothing_: true  # 是否启用位姿平滑
  smooth_window_size_: 10        # 平滑窗口大小
  
# IMU参数
fastlio2_imu_options:
  imu_init_time_: 3.0
  imu_init_queue_length_: 600
  imu_init_pos_cov_thre_: 0.05
  imu_init_quat_cov_thre_: 0.5
  imu_use_filter_num_: 5
  time_tolerance_ms_: 10.0
  max_sync_attempts_: 3

# 初始位姿参数
fastlio2_init_pose_options:
  is_init_pose_: true
  init_pos_x_: 0.0      # 0.0
  init_pos_y_: 0.0      # 0.0
  init_pos_z_: 0.0      # 0.0
  init_ori_w_: 0.715      #0.715      # 1.0
  init_ori_x_: 0.0      # 0.0
  init_ori_y_: 0.0      # 0.0
  init_ori_z_: 0.698      #0.698      # 0.0

# 退化检测参数（持续定位阶段）
fastlio2_degradation_detection_options:
  min_inlier_ratio: 0.60        # 最小内点比例
  min_inlier_count: 150         # 最小内点数量
  max_res_mean: 0.06            # 最大平均残差(m)
  require_converged: true       # 是否要求收敛 
  enter_frames: 3               # 连续坏帧进入退化
  exit_frames: 3                # 连续好帧退出退化

# 精细初始化阶段的质量阈值（初始化阶段）
fastlio2_fine_init_degradation_options:
  enable_fine_init_check: true  # 是否启用精细初始化质量判断
  ok_required_frames: 2         # 连续满足条件的帧数
  max_failure_frames: 3        # 连续失败帧数达到该值则触发重定位
  min_inlier_ratio: 0.50        # 精细初始化最小内点比例
  min_inlier_count: 500         # 精细初始化最小内点数量
  max_res_mean: 0.05            # 精细初始化最大平均残差(m)

# 定位质量评估阈值参数
fastlio2_localization_quality_thresholds_options:
  continuous_fitness_threshold: 0.25    # 持续定位适应度阈值
  continuous_ratio_threshold: 0.50      # 持续定位内点比例阈值
  continuous_count_threshold: 150       # 持续定位内点数量阈值 
  global_fitness_threshold: 0.3         # 全局定位适应度阈值
  global_ratio_threshold: 0.6           # 全局定位内点比例阈值
  global_count_threshold: 100           # 全局定位内点数量阈值

# 点云滤波参数
fastlio2_point_cloud_filter_options:
  globalmap_voxel_size_: 0.2      # 0.2
  cloud_voxel_size_: 0.3         # NX 0.2; 3588 0.4
  globalmap_kdtree_filter_size_1_: 0.18
  globalmap_kdtree_filter_size_2_: 0.20
# ICP参数
fastlio2_icp_options:
  max_iterations: 100
  transformation_epsilon: 1e-6
  first_icp_fitness_threshold: 0.5      # 第一次ICP匹配适应度阈值
  first_icp_ratio_threshold: 0.35       # 第一次ICP匹配内点比例阈值
  second_icp_fitness_threshold: 0.2     # 第二次ICP匹配适应度阈值    # 0.3   # 0.25    # 0.2
  second_icp_ratio_threshold: 0.55       # 第二次ICP匹配内点比例阈值  # 0.4    # 0.45   # 0.5

  # 自动重触发参数
  enable_init_auto_retrigger: true          # 启用精细初始化阶段自动重触发
  enable_continuous_auto_retrigger: true    # 启用持续定位阶段自动重触发
  fine_init_failure_threshold: 50           # 精细初始化连续失败帧数阈值
  continuous_lost_threshold: 100            # 持续定位丢失连续帧数阈值

# IMU到Base变换矩阵 (4x4, 行优先, 16个元素)
fastlio2_imu2base_options:    # imu非水平安装时配置   # Airy Lidar head     # Livox Lidar                  
