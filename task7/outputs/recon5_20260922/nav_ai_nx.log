bt_navigator_rclcpp_node:
  ros__parameters:
    use_sim_time: False

bt_navigator_navigate_to_pose_rclcpp_node:
  ros__parameters:
    debug: True
    use_sim_time: False
    target_lost_detect_min_dist: 1.5
    q0: 0.01
    q1: 0.04
    q2: 0.06
    r0: 0.058
    r1: 0.058
    r2: 0.06
    p_s: 0.85
    smoothing_window: 3
    d2_quantile: 0.99
    warmup_trace_threshold: 10.0

bt_navigator_navigate_through_poses_rclcpp_node:
  ros__parameters:
    debug: True
    use_sim_time: False
    multi_path_selector:
      # Global settings
      default_timeout_ms: 50.0
      enable_fast_pruning: True
      max_candidate_paths: 10
      min_candidate_paths: 2

      # Default scoring weights (must sum to ~1.0)
      default_weights:
        safety_weight: 0.3
        reference_deviation_weight: 0.3
        smoothness_weight: 0.20
        efficiency_weight: 0.15
        kinematic_feasibility_weight: 0.05

      # Fast pruner configuration
      fast_pruner:
        min_obstacle_distance: 0.15   # Minimum distance to obstacles (m)
        max_path_length: 10.0         # Maximum reasonable path length (m)
        max_curvature: 3.0            # Maximum allowed curvature (1/m)
        max_avg_curvature: 1.0        # Maximum average allowed curvature (1/m)
        min_point_separation: 0.1     # Minimum distance between path points (m)
        min_path_points: 3            # Minimum number of points in path
        collision_check_step: 1       # Step size for collision checking
        robot_radius: 0.35            # Robot radius for collision checking (m)

      # Safety critic configuration
      safety_critic:
        robot_radius: 0.35
        safe_distance_threshold: 0.8       # Distance considered "safe" (m)
        critical_distance_threshold: 0.40  # Distance considered "critical" (m)
        clearance_scaling_factor: 2.0      # Scaling for clearance-to-score conversion
        path_sampling_step: 1              # Step size for path point sampling

      # Reference deviation critic configuration
      reference_deviation_critic:
        max_lateral_deviation: 1.0       # Maximum acceptable lateral deviation (m)
        max_heading_deviation: 1.57      # Maximum acceptable heading deviation (rad, ~90 deg)
        lateral_weight: 0.7              # Weight for lateral deviation component
        heading_weight: 0.2              # Weight for heading deviation component
        endpoint_weight: 0.1             # Weight for endpoint deviation component
        normalize_by_path_length: True   # Whether to normalize by path length
        deviation_scaling_factor: 1.5    # Scaling factor for score conversion

      # Smoothness critic configuration 
      smoothness_critic:
        max_acceptable_curvature: 0.65       # Maximum acceptable curvature (1/m)
        max_acceptable_acceleration: 2.0     # Maximum acceptable acceleration (m/s^2）
        max_acceptable_angular_accel: 2.0    # Maximum angular acceleration (rad/s^2)
        curvature_weight: 0.4                # Weight for curvature component
        acceleration_weight: 0.3             # Weight for acceleration component
        angular_acceleration_weight: 0.2     # Weight for angular acceleration
        variation_weight: 0.1                # Weight for curvature variation component
        expected_velocity: 1.0               # Expected robot velocity for time estimation
        sharp_turn_threshold: 1.0            # Curvature threshold for sharp turn detection
        penalize_sharp_turns: true           # Whether to penalize sharp turns

      # Efficiency critic configuration
      efficiency_critic:
        expected_velocity: 1.0                # Expected robot velocity (m/s)
        length_weight: 0.4                    # Weight for path length component
        time_weight: 0.3                      # Weight for travel time component
        energy_weight: 0.2                    # Weight for energy cost component
        directness_weight: 0.1                # Weight for directness component
        max_acceptable_length: 10.0           # Maximum acceptable path length (m)
        max_acceptable_time: 10.0             # Maximum acceptable travel time (s)
        use_different_goals_evaluation: True  # Whether to evaluate multiple goals
        max_projection_distance: 5.0          # Maximum distance for projection (m)
        endpoint_tolerance: 1.0               # Allowed endpoint tolerance (m)

      # Kinematic feasibility critic configuration
      kinematic_feasibility_critic:
        min_turning_radius: 2.0           # Minimum turning radius for quadruped (m)
        max_turning_radius: 100.0         # Maximum reasonable turning radius (m)
        max_slope_angle: 0.5              # Maximum slope angle (~28 degrees, rad)
        max_velocity: 2.0                 # Maximum robot velocity (m/s)
        max_linear_acceleration: 2.0      # Maximum linear acceleration (m/s^2)
        max_lateral_acceleration: 2.0     # Maximum lateral acceleration (m/s^2)
        check_slope_constraints: False    # Whether to check slope constraints
        check_turning_constraints: True   # Whether to check turning constraints

bt_navigator_explore_through_poses_rclcpp_node:
  ros__parameters:
    debug: False
    use_sim_time: False

behavior_server:
  ros__parameters:
    odom_topic: /odom/current_pose
    costmap_topic: /navigo/lcc/cmn/vis/costmap_raw
    footprint_topic: /navigo/lcc/cmn/vis/published_footprint
    track_unknown_space: False
    cycle_frequency: 10.0
    behavior_plugins: [ "spin", "backup", "drive_on_heading", "wait" ]
    spin:
      plugin: "navigo_behaviors/Spin"
    backup:
      plugin: "navigo_behaviors/BackUp"
    drive_on_heading:
      plugin: "navigo_behaviors/DriveOnHeading"
    wait:
      plugin: "navigo_behaviors/Wait"
    global_frame: odom
    robot_base_frame: base_link
    transform_tolerance: 0.1
    use_sim_time: True
    simulate_ahead_time: 2.0
    max_rotational_vel: 1.2
    min_rotational_vel: 0.4
    rotational_acc_lim: 3.2

local_costmap:
  local_costmap:
    ros__parameters:
      odom_topic: /odom/current_pose
      update_frequency: 10.0
      publish_frequency: 10.0
      global_frame: odom
      robot_base_frame: base_link
      use_sim_time: False
      rolling_window: True
      width: 8
      height: 8
      resolution: 0.05
      plugins: [ "obstacle_layer", "electronic_map_layer", "inflation_layer" ]
      electronic_map_layer:
        plugin: "navigo_costmap_2d::ElectronicMapLayer"
        enabled: True
        electronic_map_topic: "/electronic_map"
        transform_tolerance: 0.1
        debug_mode: False
      inflation_layer:
        plugin: "navigo_costmap_2d::InflationLayer"
        cost_scaling_factor: 3.0
        inflation_radius: 0.05
      obstacle_layer:
        plugin: "navigo_costmap_2d::ObstacleLayer"
        enabled: True
        goal_safe_area: "[[0.40,0.4],[0.4,-0.4],[-0.4,-0.4],[-0.4,0.4]]"
        goal_clearing_enabled: True
        footprint_clearing_enabled: True
        planner_goal_valid_time_range: 5.0
        observation_persistence: 0.0
        observation_sources: scan
        scan:
          topic: /laser_scan
          max_obstacle_height: 2.0
          clearing: True
          marking: True
          inf_is_valid: True
          data_type: "LaserScan"
          raytrace_max_range: 8.0
          raytrace_min_range: 0.0
          obstacle_max_range: 8.5
          obstacle_min_range: 0.5
      always_send_full_costmap: True
  local_costmap_client:
    ros__parameters:
      use_sim_time: False
  local_costmap_rclcpp_node:
    ros__parameters:
      use_sim_time: False

local_costmap_controller:
  local_costmap_controller:
    ros__parameters:
      odom_topic: /odom/current_pose
      update_frequency: 10.0
      publish_frequency: 10.0
      global_frame: odom
      robot_base_frame: base_link
      use_sim_time: False
      rolling_window: True
      width: 8
      height: 8
      resolution: 0.05
      plugins: [ "obstacle_layer", "inflation_layer" ]
      static_layer:
        plugin: "navigo_costmap_2d::StaticLayer"
        map_subscribe_transient_local: False
      inflation_layer:
        plugin: "navigo_costmap_2d::InflationLayer"
        cost_scaling_factor: 3.0
        inflation_radius: 0.05
      obstacle_layer:
        plugin: "navigo_costmap_2d::ObstacleLayer"
        enabled: True
        goal_clearing_enabled: True
        planner_goal_valid_time_range: 5.0
        observation_persistence: 0.0
        observation_sources: scan
        scan:
          topic: /laser_scan
          max_obstacle_height: 2.0
          clearing: True
          marking: True
          inf_is_valid: True
          data_type: "LaserScan"
          raytrace_max_range: 8.0
          raytrace_min_range: 0.0
          obstacle_max_range: 8.5
          obstacle_min_range: 0.5

global_costmap:
  global_costmap:
    ros__parameters:
      odom_topic: /odom/current_pose
      map_topic: /navigo/ms/cmn/intf/map
      update_frequency: 10.0
      publish_frequency: 10.0
      resolution: 0.05
      global_frame: map
      robot_base_frame: base_link
      use_sim_time: False
      plugins: [ "static_layer", "electronic_map_layer", "inflation_layer", "frontier_layer" ]
      static_layer:
        plugin: "navigo_costmap_2d::StaticLayer"
        map_subscribe_transient_local: False
        footprint_clearing_enabled: True
        restore_cleared_footprint: True
      electronic_map_layer:
        plugin: "navigo_costmap_2d::ElectronicMapLayer"
        enabled: True
        electronic_map_topic: "/electronic_fence"
        transform_tolerance: 0.1
        debug_mode: False
      inflation_layer:
        plugin: "navigo_costmap_2d::InflationLayer"
        cost_scaling_factor: 3.0
        inflation_radius: 0.1
      frontier_layer:
        plugin: "navigo_costmap_2d::FrontierLayer"
        map_subscribe_transient_local: False
        obstacle_inflation_radius: 0.3
        obstacle_threshold: 65
        travel_point_type: "closest" #closest middle centroid
        frontier_min_size: 10
      esdf_layer:
        plugin: "navigo_costmap_2d::ESDFLayer"
        enabled: False
        esdf_pos_dis_topic_name: esdf_pos_distance_field
        esdf_neg_dis_topic_name: esdf_neg_distance_field
        esdf_combine_dis_topic_name: esdf_combine_distance_field
        esdf_gradient_topic_name: esdf_gradient
        visualize_pos_dis_esdf: False
        visualize_neg_dis_esdf: False
        visualize_combine_dis_esdf: False
        visualize_gradient: False
      always_send_full_costmap: False
  global_costmap_client:
    ros__parameters:
      use_sim_time: False
  global_costmap_rclcpp_node:
    ros__parameters:
      use_sim_time: False

map_server:
  ros__parameters:
    use_sim_time: False
    yaml_filename: " "

map_saver:
  ros__parameters:
    use_sim_time: False
    save_map_timeout: 5.0
    free_thresh_default: 0.25
    occupied_thresh_default: 0.65
    map_subscribe_transient_local: False

planner_server:
  ros__parameters:
    odom_topic: /odom/current_pose
    use_sim_time: False
    expected_planner_frequency: 20.0
    # extension line
    need_extension: False
    extension_dis: 0.5
    extension_step_size: 0.05
    # planning path generation format
    use_fixed_spacing_trajectory_generation: True
    use_history_path_info: False
    # tracking function 
    fov_near_goal_dist: 5.0
    out_of_fov_threshold: 20.0
    # collision checker
    use_esdf_collision_checker: False
    three_circle_check_margin: 0.03
    three_circle_fine_check_sample_res: 0.05
    # pp + fem get optimized path
    enable_pp_fem_debug_output: False
    # esdf info
    build_global_esdf_map: True
    build_local_esdf_map: True
    global_esdf_visualizer_open: False
