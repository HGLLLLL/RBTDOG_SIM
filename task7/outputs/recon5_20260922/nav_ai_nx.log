  txt_pose_rounds: 0          # TXT Pose遍历轮数
  dbow_attempts: 10           # DBoW最大尝试次数  
  scancontext_attempts: 40    # ScanContext最大尝试次数
  dynamic_keyframe_max_attempts: 20  # 动态关键帧选择最大尝试次数（ScanContext失败后使用） 
  gnss_attempts: 0           # GNSS 初始化策略最大尝试次数（策略层），达到上限后不再尝试GNSS

# 动态地图层配置
fastlio2_dynamic_map_layer_options:
  enable_dynamic_map_layer: false    # 是否启用动态地图层功能
  update_distance_threshold: 2.0    # 更新距离阈值(米)
