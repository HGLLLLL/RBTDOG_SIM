-- 廠商自己的 BT（非 nav2 內建）--
@@FILE /opt/robot/robot_nav/install/navigo_bt_navigator/share/navigo_bt_navigator/behavior_trees/navigate_to_uwb_target.xml
<?xml version="1.0"?>
<root main_tree_to_execute="MainTree">
    <!-- ////////// -->
    <BehaviorTree ID="MainTree">
        <Control ID="PipelineSequence" name="NavigateWithReplanning">
            <Action ID="EvaluateGoal" evaluated_goal="{evaluated_goal}" goal_predicted_path="{goal_predicted_path}" input_goal="{goal}" is_target_lost="{is_target_lost}" max_update_interval="0.5" name="EvaluateUWBTarget" predicted_goal="{predicted_goal}" prediction_duration="1.0" prediction_time_step="0.05" target_lost_duration="{target_lost_duration}"/>
            <Decorator ID="RateController" hz="2.0">
                <Fallback name="ComputePath">
                    <Inverter name="IsGoalNotUpdated?">
                        <Condition ID="GlobalUpdatedGoal" angle_tolerance="0.087" any="true" dist_tolerance="0.2" goal="{evaluated_goal}" name="IsGoalUpdated?"/>
                    </Inverter>
                    <Control ID="RecoveryNode" name="ComputePathRecovery" number_of_retries="6666">
                        <Action ID="ComputePathToPose" frontend_id="" function_id="TrackingUWB" goal="{evaluated_goal}" goal_predicted_path="" path="{path}" planner_id="GridBasedSL" server_name="compute_path_to_pose" server_timeout="{server_timeout}" start="" track_unknown_space="true" use_global_costmap="false" use_goal_predicted_path="false" use_local_costmap="true" use_start="false"/>
                        <Fallback name="ComputePathRecovery">
                            <AlwaysSuccess name="ComputePathRecoveryAlwaysSuccess"/>
                            <Action ID="ClearEntireCostmap" name="ClearLocalCostmap-Context" server_timeout="{server_timeout}" service_name="local_costmap/clear_entirely_local_costmap"/>
                        </Fallback>
                    </Control>
                </Fallback>
            </Decorator>
            <Action ID="PublishDebugMsgs" candidate_local_paths="" function_id="TrackingUWB" global_path="" goal="{goal}" goals="" local_path="{path}"/>
            <Action ID="ComputeGoalDistance" distance_error="{distance_to_goal}" goal="{goal}" heading_error="{heading_to_goal}" name="ComputeUWBTargetDistance"/>
            <KeepRunningUntilFailure>
                <ReactiveFallback name="LocalControl">
                    <ReactiveSequence name="RotateToGoal">
                        <Condition ID="DoubleLessThanCondition" name="IsCloseToGoal?" threshold="2.0" value="{distance_to_goal}"/>
                        <Action ID="FollowPath" controller_id="FollowPathPID" desired_angular_vel_z="{desired_angular_vel_z}" desired_linear_vel_x="0.0" desired_linear_vel_y="0.0" function_id="TrackingUWB" goal="{evaluated_goal}" goal_checker_id="" kinematics_model="" lookahead_time="0.0" name="RotateToGoal" path="{path}" server_name="follow_path" server_timeout="{server_timeout}" use_goal="true" xy_goal_tolerance="5.0" yaw_goal_tolerance="{yaw_goal_tolerance}"/>
                    </ReactiveSequence>
                    <Action ID="FollowPath" controller_id="{default_controller_id}" desired_angular_vel_z="{desired_angular_vel_z}" desired_linear_vel_x="{desired_linear_vel_x}" desired_linear_vel_y="0.0" function_id="TrackingUWB" goal="{evaluated_goal}" goal_checker_id="" kinematics_model="ackermann" lookahead_time="1.5" path="{path}" server_name="follow_path" server_timeout="{server_timeout}" use_goal="true" xy_goal_tolerance="0.25" yaw_goal_tolerance="3.14"/>
                </ReactiveFallback>
            </KeepRunningUntilFailure>
        </Control>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <SubTree ID="AssistRelocalization">
            <input_port default="true" name="__shared_blackboard">If false (default), the Subtree has an isolated                blackboard and needs port remapping            </input_port>
        </SubTree>
        <Action ID="AssistedTeleop">
            <input_port name="is_recovery">If true recovery count will be incremented</input_port>
            <input_port name="server_name">Service name</input_port>
            <input_port name="server_timeout">Server timeout</input_port>
            <input_port name="time_allowance">Allowed time for spinning</input_port>
        </Action>
        <Action ID="BackUp">
            <input_port name="backup_dist">Distance to backup</input_port>
            <input_port name="backup_speed">Speed at which to backup</input_port>
            <input_port name="check_collision">Whether to check collision</input_port>
            <input_port name="server_name">Server name</input_port>
            <input_port name="server_timeout">Server timeout</input_port>
            <input_port name="time_allowance">Allowed time for reversing</input_port>
        </Action>
        <Condition ID="BoolEqualToCondition">
            <input_port name="threshold">Threshold</input_port>
            <input_port name="value">Value</input_port>
        </Condition>
        <Action ID="CancelAssistedTeleop">
