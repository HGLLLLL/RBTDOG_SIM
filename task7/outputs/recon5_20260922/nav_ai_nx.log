            <Sequence name="GlobalPlanning">
                <Action ID="SelectFrontendIDs" distance_threshold="0.0" frontend_ids="{frontend_ids}" goals="{original_key_poses}" heading_threshold="0.0"/>
                <Action ID="ComputePathThroughPoses" frontend_id="Quadtree" function_id="Patrol" goals="{original_key_poses}" name="ComputeReferencePaths" path="{original_reference_path}" paths="{original_reference_paths}" planner_id="GridBasedST" reference_path="" server_name="compute_path_through_poses" server_timeout="{server_timeout}" start="" track_unknown_space="false" use_global_costmap="true" use_local_costmap="true" use_reference_path="false" use_rotation="true" use_start="false"/>
                <Action ID="SeparatePaths" input_key_poses="{original_key_poses}" input_paths="{original_reference_paths}" max_separation_dist="5.0" min_separation_dist="3.0" output_key_poses="{separated_key_poses}" output_paths="{separated_reference_paths}" window_size="1.0" yaw_threshold="1.0"/>
                <Action ID="OptimizePath" key_poses="{separated_key_poses}" optimized_key_poses="{optimized_key_poses}" optimized_paths="{optimized_reference_paths}" paths="{separated_reference_paths}" server_timeout="{server_timeout}" service_name="get_optimized_path" smooth_method="PP"/>
                <Action ID="TruncatePaths" input_key_poses="{optimized_key_poses}" input_paths="{optimized_reference_paths}" output_key_poses="{goals}" output_paths="{reference_paths}"/>
                <Sequence name="PostSetup">
                    <SetBlackboard name="SetUseReferencePath" output_key="use_reference_path" value="true"/>
                    <SetBlackboard name="SetFirstTime" output_key="first_time" value="true"/>
                    <SetBlackboard name="SetIsFinalGoal" output_key="is_final_goal" value="false"/>
                </Sequence>
            </Sequence>
            <Control ID="PipelineSequence" name="Navigation">
                <Sequence name="UpdateGoalsAndReferencePaths">
                    <Action ID="RemovePassedGoals" current_goal="{goal}" current_goals="{current_goals}" current_path="{raw_path}" current_reference_path="{reference_path}" final_goal="{final_goal}" input_first_time="{first_time}" input_goal_reached="{goal_reached}" input_goals="{goals}" input_reference_paths="{reference_paths}" last_reference_path="{last_reference_path}" next_reference_path="{next_reference_path}" output_first_time="{first_time}" output_goal_reached="{goal_reached}" output_goals="{goals}" output_reference_paths="{reference_paths}" radius="1.5" use_reference_path="{use_reference_path}"/>
                    <Fallback name="StitcherReferencePath">
                        <Inverter name="IsGoalNotUpdated?">
