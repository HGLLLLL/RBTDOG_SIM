<?xml version="1.0"?>
<root main_tree_to_execute="MainTree">
    <!-- ////////// -->
    <BehaviorTree ID="MainTree">
        <ReactiveSequence name="NavigateWithReplanning">
            <Action ID="EvaluateGoal" evaluated_goal="{evaluated_goal}" goal_predicted_path="{goal_predicted_path}" input_goal="{goal}" is_target_lost="{is_target_lost}" max_update_interval="0.5" name="EvaluatePerceptionTarget" predicted_goal="{predicted_goal}" prediction_duration="1.0" prediction_time_step="0.05" target_lost_duration="{target_lost_duration}"/>
            <ReactiveFallback name="Navigate">
                <ReactiveSequence name="Searching">
                    <Condition ID="BoolEqualToCondition" name="IsTargetLost?" threshold="true" value="{is_target_lost}"/>
                    <Control ID="PipelineSequence" name="Searching">
                        <Action ID="ComputeSpinDistance" goal="{evaluated_goal}" spin_distance="{spin_distance}"/>
                        <Action ID="Spin" name="SpinSearching" server_name="spin" server_timeout="{server_timeout}" spin_dist="{spin_distance}" time_allowance="10.0"/>
                        <KeepRunningUntilFailure name="IsTargetLostDurationWithinTolerance?">
                            <Condition ID="DoubleLessThanCondition" name="IsTargetLostDurationWithinTolerance?" threshold="10.0" value="{target_lost_duration}"/>
                        </KeepRunningUntilFailure>
                    </Control>
                </ReactiveSequence>
                <ReactiveSequence name="Tracking">
                    <Condition ID="BoolEqualToCondition" name="IsTargetNotLost?" threshold="false" value="{is_target_lost}"/>
                    <Control ID="PipelineSequence" name="Tracking">
                        <Decorator ID="RateController" hz="5.0">
                            <Fallback name="UpdatePlanningGoal">
                                <Sequence name="IsReplanNotNecessary?">
                                    <Inverter name="IsGoalNotUpdated?">
                                        <Condition ID="GlobalUpdatedGoal" angle_tolerance="-1.0" any="false" dist_tolerance="0.2" goal="{evaluated_goal}" name="IsGoalUpdated?"/>
                                    </Inverter>
                                    <Condition ID="IsTargetInFov" fov_tolerance_far="0.78" fov_tolerance_near="0.26" name="IsTargetInFov?" server_timeout="{server_timeout}"/>
                                </Sequence>
                                <Sequence name="ComputePathToPose">
                                    <SetBlackboard name="SetPlanningGoal" output_key="planning_goal" value="{evaluated_goal}"/>
                                    <Action ID="ComputePathToPose" frontend_id="Polynomial" function_id="Tracking" goal="{planning_goal}" goal_predicted_path="{goal_predicted_path}" path="{planned_path}" planner_id="GridBasedST" server_name="compute_path_to_pose" server_timeout="{server_timeout}" start="" track_unknown_space="true" use_global_costmap="false" use_goal_predicted_path="true" use_local_costmap="false" use_start="false"/>
                                    <Action ID="TruncatePathToGoal" distance_to_goal="0.5" input_goal="{planning_goal}" input_path="{planned_path}" output_goal="{truncated_goal}" output_path="{truncated_path}"/>
                                    <Action ID="UpdatePath" input_path="{truncated_path}" output_path="{path}"/>
                                </Sequence>
                            </Fallback>
                        </Decorator>
                        <Action ID="PublishDebugMsgs" candidate_local_paths="" function_id="Tracking" global_path="" goal="{goal}" goals="" local_path="{path}" name="PublishTrackingDebugMsgs"/>
                        <Action ID="FollowPath" controller_id="FollowPathPP" desired_angular_vel_z="{desired_angular_vel_z}" desired_linear_vel_x="{desired_linear_vel_x}" desired_linear_vel_y="{desired_linear_vel_y}" function_id="Tracking" goal="{truncated_goal}" goal_checker_id="" kinematics_model="ackermann" lookahead_time="1.5" path="{path}" server_name="follow_path" server_timeout="{server_timeout}" use_goal="true" xy_goal_tolerance="0.25" yaw_goal_tolerance="0.25"/>
                    </Control>
                </ReactiveSequence>
            </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <SubTree ID="AssistRelocalization">
            <input_port default="true" name="__shared_blackboard">If false (default), the Subtree has an isolated                blackboard and needs port remapping            </input_port>
        </SubTree>
        <Action ID="AssistedTeleop">
            <input_port name="is_recovery">If true recovery count will be incremented</input_port>
            <input_port name="server_name">Service name</input_port>
            <input_port name="server_timeout">Server timeout</input_port>
            <input_port name="time_allowance">Allowed time for spinning</input_port>
        </Action>
        <Action ID="BackUp">
            <input_port name="backup_dist">Distance to backup</input_port>
            <input_port name="backup_speed">Speed at which to backup</input_port>
            <input_port name="check_collision">Whether to check collision</input_port>
            <input_port name="server_name">Server name</input_port>
            <input_port name="server_timeout">Server timeout</input_port>
            <input_port name="time_allowance">Allowed time for reversing</input_port>
        </Action>
        <Condition ID="BoolEqualToCondition">
            <input_port name="threshold">Threshold</input_port>
            <input_port name="value">Value</input_port>
        </Condition>
        <Action ID="CancelAssistedTeleop">
            <input_port name="server_name">Server name to cancel the assisted teleop behavior</input_port>
            <input_port name="server_timeout">Server timeout</input_port>
        </Action>
        <Action ID="CancelBackUp">
            <input_port name="server_name">Server name to cancel the backup behavior</input_port>
            <input_port name="server_timeout">Server timeout</input_port>
        </Action>
        <Action ID="CancelControl">
            <input_port name="server_name">Server name to cancel the controller server</input_port>
            <input_port name="server_timeout">Server timeout</input_port>
        </Action>
        <Action ID="CancelDriveOnHeading">
            <input_port name="server_name">Service name to cancel the drive on heading behavior</input_port>
@@FILE /opt/robot/robot_nav/install/navigo_bt_navigator/share/navigo_bt_navigator/behavior_trees/navigate_to_uwb_target_unused.xml
<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <PipelineSequence name="NavigateWithReplanning">
            <ProgressCheck/>
            <ReactiveFallback name="CancelAction">
                <Sequence>
                    <Sequence>
                        <DoubleGreaterThanCondition value="{straight_distance_remaining}"
                                                    threshold="{uwb_nav_mode_switch_lower_threshold}"/>
                        <DoubleLessThanCondition value="{straight_distance_remaining}"
                                                 threshold="{uwb_nav_mode_switch_upper_threshold}"/>
                    </Sequence>
                    <Fallback>
                        <Inverter>
                            <GlobalUpdatedGoal goal="{goal}" dist_tolerance="-1" angle_tolerance="0.09"/>
                        </Inverter>
                        <CancelSpin/>
                    </Fallback>
                    <CancelFollowPath/>
                </Sequence>
                <Sequence>
                    <Fallback>
                        <DoubleGreaterThanOrEqualToCondition value="{straight_distance_remaining}"
                                                             threshold="{uwb_nav_mode_switch_upper_threshold}"/>
                        <DoubleLessThanOrEqualToCondition value="{straight_distance_remaining}"
                                                          threshold="{uwb_nav_mode_switch_lower_threshold}"/>
                    </Fallback>
                    <CancelSpin/>
                </Sequence>
            </ReactiveFallback>
            <RateController hz="1.0">
                <Fallback>
                    <Inverter>
                        <Sequence>
                            <Fallback>
                                <DoubleGreaterThanOrEqualToCondition value="{straight_distance_remaining}"
                                                                     threshold="{uwb_nav_mode_switch_upper_threshold}"/>
                                <DoubleLessThanOrEqualToCondition value="{straight_distance_remaining}"
                                                                  threshold="{uwb_nav_mode_switch_lower_threshold}"/>
                            </Fallback>
                            <GlobalUpdatedGoal goal="{goal}" dist_tolerance="0.15" angle_tolerance="-1"/>
                        </Sequence>
                    </Inverter>
                    <Sequence>
                        <ComputeUwbGoal input_goal="{goal}" uwb_goal="{uwb_goal}"/>
                        <ComputePathToPose goal="{uwb_goal}" path="{path}" planner_id="GridBasedSL"
                                           function_id="TrackingUWB"/>
                    </Sequence>
                </Fallback>
            </RateController>
            <ReactiveFallback name="TakeAction">
                <Sequence>
                    <Fallback>
                        <DoubleGreaterThanOrEqualToCondition value="{straight_distance_remaining}"
                                                             threshold="{uwb_nav_mode_switch_upper_threshold}"/>
                        <DoubleLessThanOrEqualToCondition value="{straight_distance_remaining}"
                                                          threshold="{uwb_nav_mode_switch_lower_threshold}"/>
                    </Fallback>
                    <FollowPath goal="{uwb_goal}" path="{path}" controller_id="FollowPathPP" function_id="TrackingUWB"/>
                </Sequence>
                <Sequence>
                    <Sequence>
                        <DoubleLessThanCondition value="{straight_distance_remaining}"
                                                 threshold="{uwb_nav_mode_switch_upper_threshold}"/>
                        <DoubleGreaterThanCondition value="{straight_distance_remaining}"
                                                    threshold="{uwb_nav_mode_switch_lower_threshold}"/>
                    </Sequence>
                    <Spin spin_dist="{heading_distance_remaining}"/>
                </Sequence>
            </ReactiveFallback>
        </PipelineSequence>
    </BehaviorTree>
</root>@@FILE /opt/robot/robot_nav/install/navigo_bt_navigator/share/navigo_bt_navigator/behavior_trees/navigate_through_poses_to_target_without_replan.xml
