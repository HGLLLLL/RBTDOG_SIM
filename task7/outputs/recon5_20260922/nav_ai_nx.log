                <Action ID="PublishDebugMsgs" function_id="Patrol" goal="{goal}" goals="{goals}" path="{stitched_reference_path}" paths="{reference_paths}"/>
                <Action ID="FollowPath" controller_id="FollowPathLocalPlanner" desired_angular_vel_z="{desired_angular_vel_z}" desired_linear_vel_x="{desired_linear_vel_x}" desired_linear_vel_y="0.0" function_id="Patrol" goal="{goal}" goal_checker_id="" kinematics_model="ackermann" lookahead_time="1.5" name="RegularFollowPath" path="{stitched_reference_path}" server_name="follow_path" server_timeout="{server_timeout}" use_goal="true" xy_goal_tolerance="{xy_goal_tolerance}" yaw_goal_tolerance="{yaw_goal_tolerance}"/>
