# 点云预处理参数
lidar_preprocess_options:
  point_sampling_interval: 4  # 点云采样间隔，用于下采样（lidar_preprocess使用）   # NX 1 or 2; 3588 4   Airy 4
  blind_distance: 0.8         # 最小距离阈值
  max_distance: 30.0          # 最大距离阈值
# DBoW 视觉重定位配置
dbow_reloc_options_:
  enable_dbow_reloc_: true
  dbow_confidence_threshold_: 0.15
  min_matching_inlier_threshold_: 20
  camera_sync_tolerance_sec_: 0.3  # 图像时间戳同步容差(秒)
  dbow_frame_skip_: 4              # 每N帧执行1次（1表示每帧都跑）
  dbow_min_interval_ms_: 240       # 连续两次执行的最小时间间隔（毫秒）
  dbow_force_run_after_skips_: 6   # 连续跳过多少次后强制执行1次
  # 路径模式：absolute | relative | dynamic
  path_mode_: "absolute"
  fallback_vocabulary_path_: "/ota/map/map_voc.bin"  # 回退路径，当主路径不存在时使用       
  enable_image_resize_: true   # 是否启用图像resize（默认false，不resize）
  image_resize_scale_: 0.5     # resize比例（0.5表示减半，1.0表示不resize）
  enable_image_undistort_: true
  orb_num_features_: 1000
  enable_save_dbow_images_: false   # 是否保存DBoW匹配到的关键帧图像和当前帧图像（调试用）
  dbow_image_save_dir_: "/home/user/Downloads/"   # 图像保存目录（绝对路径）"/home/user/Downloads/"
  enable_geometric_verification_: false
  # 全局定位策略配置
fastlio2_global_localization_strategy_options:
  CONFIG_POSE: 0              # 配置文件位姿策略的位置
