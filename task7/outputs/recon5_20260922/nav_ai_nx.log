  SCANCONTEXT: 3              # ScanContext匹配策略的位置
  # 各策略的尝试次数限制
  config_pose_attempts: 1     # Config Pose最大尝试次数 1
  txt_pose_rounds: 0          # TXT Pose遍历轮数 1
  dbow_attempts: 5            # DBoW最大尝试次数 20
  scancontext_attempts: 15    # ScanContext最大尝试次数 20
  dynamic_keyframe_max_attempts: 15  # 动态关键帧选择最大尝试次数（ScanContext失败后使用） 50
  gnss_attempts: 10           # GNSS 初始化策略最大尝试次数（策略层），达到上限后不再尝试GNSS

# 动态地图层配置
fastlio2_dynamic_map_layer_options:
  enable_dynamic_map_layer: false    # 是否启用动态地图层功能
  update_distance_threshold: 2.0    # 更新距离阈值(米)
