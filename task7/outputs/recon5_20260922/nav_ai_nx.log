        visualize_neg_dis_esdf: False
        visualize_combine_dis_esdf: False
        visualize_gradient: False
      always_send_full_costmap: False
  global_costmap_client:
    ros__parameters:
      use_sim_time: False
  global_costmap_rclcpp_node:
    ros__parameters:
      use_sim_time: False

map_server:
  ros__parameters:
    use_sim_time: False
    yaml_filename: " "

map_saver:
  ros__parameters:
    use_sim_time: False
    save_map_timeout: 5.0
    free_thresh_default: 0.25
    occupied_thresh_default: 0.65
    map_subscribe_transient_local: False

planner_server:
  ros__parameters:
    odom_topic: /odom/current_pose
    use_sim_time: False
    expected_planner_frequency: 20.0
    # extension line
    need_extension: False
    extension_dis: 0.5
